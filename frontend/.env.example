# Copy to frontend/.env. Values are baked in at build time (Vite), so
# changing them on Vercel needs a fresh build, not just a restart.

# Backend base URL, including /api. Required.
VITE_API_BASE_URL=http://localhost:5000/api

# Optional
VITE_API_TIMEOUT=10000
VITE_APP_NAME=Cerkyl
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=
VITE_CDN_URL=
