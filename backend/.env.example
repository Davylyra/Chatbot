# Copy to backend/.env and fill in. Never commit the real .env.

PORT=5000
NODE_ENV=development            # must be "production" on Render

# MongoDB Atlas. If mongodb+srv:// fails with "querySrv ECONNREFUSED"
# (a local DNS issue on some Windows machines/ISPs), use the standard
# mongodb://host1,host2,host3/?tls=true&replicaSet=...&authSource=admin form.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=glinax_chatbot_db

# Same value as ai-rag-service/.env. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed frontend origins (CORS). Required.
FRONTEND_URL=http://localhost:5173

# Full URL of the AI service's /respond endpoint (include /respond).
AI_SERVICE_URL=http://localhost:8000/respond

# Shared secret sent as X-Internal-Key to the AI service. Must match
# ai-rag-service/.env when set (leave blank locally if not enforcing).
INTERNAL_API_KEY=

# Groq: used here only for conversation titles. https://console.groq.com
GROQ_API_KEY=

# Brevo: signup verification + purchase emails. https://app.brevo.com
# FROM_EMAIL must be a sender verified in Brevo, or sends are rejected.
BREVO_API_KEY=
FROM_EMAIL=
ADMIN_EMAIL=

# Paystack (use test keys locally). https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Legacy Gmail transport, only used by POST /auth/send-verification-code.
EMAIL_USER=
EMAIL_PASS=

LOG_LEVEL=info

# Local development only: print verification codes in the terminal and
# skip the code step on the signup page. Ignored when NODE_ENV=production.
DEV_SKIP_EMAIL=false
