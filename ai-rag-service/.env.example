# Copy to ai-rag-service/.env and fill in. Never commit the real .env.

# Groq LLM (required for real answers). https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=medium
GROQ_TEMPERATURE=0.6

# Same database and JWT secret as the backend.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
DB_NAME=glinax_chatbot_db
JWT_SECRET=

# Shared secret required in X-Internal-Key for /respond and /respond-with-files.
# Must match backend/.env. When unset, requests are allowed without the header.
INTERNAL_API_KEY=

# Comma-separated CORS origins (defaults to the local frontend + backend).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5000

# Optional: Google results via SerpAPI. Without it, DuckDuckGo is used.
SERPAPI_KEY=

# Optional: path to tesseract.exe for OCR on uploaded images. The default
# Windows install locations are detected automatically.
TESSERACT_CMD=
